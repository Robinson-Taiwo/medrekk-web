# The build host's registry access is slow and intermittently drops connections — a deploy
# failed with ETIMEDOUT on a single tarball after 288 seconds. npm's defaults give up too
# readily for that: two retries, and a per-request timeout shorter than this builder sometimes
# needs just to pull a base image.
#
# These are patience settings only. They change nothing about what gets installed, so a build
# that works stays working and one that was failing on a flaky connection gets five chances
# with a backoff instead of two.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
